# Prisma / Supabase Postgres
# Vercel runtime: use Supabase Connect > Transaction pooler (port 6543).
DATABASE_URL=
# Prisma CLI / migrations: use a direct connection or session pooler (port 5432).
DIRECT_URL=

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# NextAuth.js
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_URL=https://your-domain.example
AUTH_TRUST_HOST=true

# App
NEXT_PUBLIC_APP_URL=https://your-domain.example

# Midtrans (server-only; redirect checkout does not need a public Client Key)
# manual = transfer + upload bukti + verifikasi admin; midtrans = Snap checkout.
# NEXT_PUBLIC_* changes require a rebuild, like zonaapoteker.
NEXT_PUBLIC_PAYMENT_MODE=manual
MIDTRANS_IS_PRODUCTION=false
MIDTRANS_SERVER_KEY=
# Required after key rotation separates the signing secret from the Server Key.
MIDTRANS_SIGNATURE_SECRET_KEY=

# Seed placeholder videos only for local development.
SEED_SAMPLE_VIDEOS=false
