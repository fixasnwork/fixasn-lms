# Prisma / Supabase Postgres
# Use Supabase Connect > Session pooler (port 5432) or direct connection.
DATABASE_URL=

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# NextAuth.js
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_URL=https://your-domain.example
AUTH_TRUST_HOST=true

# App
NEXT_PUBLIC_APP_URL=https://your-domain.example

# Seed placeholder videos only for local development.
SEED_SAMPLE_VIDEOS=false
